#!/bin/sh
# gts7xlwifi: NetworkManager gets the DHCP lease but often installs no connected/default
# route -> "connected but no internet". On each Wi-Fi up/dhcp4-change, (re)install the
# routes via the shared helper (same logic the boot-time wlan-routes.service uses).
# The Wi-Fi interface enumerates as wlp1s0 / swlan0 / wlanN across boots, so match all.
IFACE="$1"; ACTION="$2"
case "$IFACE" in
    wlp1s0|swlan0|wlan[0-9]*) ;;
    *) exit 0 ;;
esac
case "$ACTION" in
    up|dhcp4-change) /usr/lib/adaptation-samsung-gts7xlwifi/wlan-routes-fix ;;
esac
exit 0
